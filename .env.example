# GleasonAI configuration. `make env` copies this to .env and fills every secret with a random value.
# Never commit .env. Every secret lives only here (or in Docker secrets), never in images or code.

# --- deployment
ENV=prod
# public host name; Caddy obtains HTTPS for it automatically (a local CA for "localhost")
DOMAIN=localhost
# browser origin of the dashboard
PUBLIC_URL=https://localhost
LOG_LEVEL=INFO

# --- security (generated by `make env`)
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# object storage (SeaweedFS S3): admin key (bucket setup, backups) and the least-privilege app key
S3_ADMIN_SECRET=change-me
S3_APP_SECRET=change-me
# encrypts nightly backups - keep a copy OFF the server, backups cannot be restored without it
BACKUP_PASSPHRASE=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# --- names
POSTGRES_USER=gleasonai
POSTGRES_DB=gleasonai
S3_ADMIN_ACCESS_KEY=gleasonai-admin
S3_BUCKET=gleasonai

# --- model (docs/deployment.md)
# local: ./models/bundle (make bundle) | hf: private Hugging Face repo (token in ./secrets/hf_token)
MODEL_SOURCE=local
HF_MODEL_REPO=Obaidullahmiakhil/prostate-fl-fedavg-phikon
HF_MODEL_REPO_TYPE=model
# pin a commit hash in production
HF_MODEL_REVISION=main
PHIKON_REPO=owkin/phikon
PHIKON_REVISION=057cc0295895c2df3dd7681a89680da6015cbefe

# --- data governance
# cases older than this are deleted automatically (0 = keep forever)
RETENTION_DAYS=3650
# "clamav" when started with --profile antivirus
CLAMAV_HOST=

# --- backups
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=14

# --- demo: host folder with PANDA .tiff test slides for `make seed-demo` (optional)
DEMO_SLIDES_DIR=

# --- monitoring (optional)
SENTRY_DSN=
# Alertmanager posts alerts here (e.g. a Slack or Teams incoming webhook)
ALERT_WEBHOOK_URL=

# --- public access via Cloudflare Tunnel (optional)
# empty = `make tunnel` gives a free random https://...trycloudflare.com link
# set a token from Cloudflare Zero Trust -> Networks -> Tunnels to use `make tunnel-named` (permanent link)
TUNNEL_TOKEN=
